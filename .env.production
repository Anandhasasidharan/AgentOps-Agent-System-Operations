# ── AgentOps Production Env ──
# Copy to .env.production and fill in values

# ── Database ──
DATABASE_URL=postgresql+asyncpg://agentops:PASSWORD@HOST:5432/agentops

# ── Auth ──
API_KEY=your-generated-slug-token

# ── Rate Limiting ──
RATE_LIMIT_RPM=120

# ── Telemetry ──
OTEL_EXPORTER_ENDPOINT=http://slo-platform:8000/v1/traces

# ── NATS (optional, for Gateway real-time) ──
NATS_URL=nats://nats:4222

# ── Dashboard Service URLs ──
CB_URL=http://circuit-breaker:8001
CHAOS_URL=http://chaos-toolkit:8002
SLO_URL=http://slo-platform:8000
GATEWAY_URL=http://gateway:8004

# ── Log Level ──
LOG_LEVEL=info
